#!/usr/bin/scripts run
# secrets.scs — the high-signal secret and site-value patterns.
#
# The patterns are POSIX ERE, because the gate runs `git grep -E`. They are
# deliberately narrow: a pass means "none of these shapes is present", not
# "the tree is safe". The module lives under tools/, which the gate excludes
# from its own scan, so the patterns do not match themselves.

public function patterns() -> list<string> {
    return [
        r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
        r"AKIA[0-9A-Z]{16}",
        r"ghp_[A-Za-z0-9]{36}",
        r"xox[baprs]-[A-Za-z0-9-]+",
        r"/home/",
        r"\b(10(\.[0-9]{1,3}){3}|192\.168(\.[0-9]{1,3}){2}|172\.(1[6-9]|2[0-9]|3[01])(\.[0-9]{1,3}){2})\b",
        r"(password|passwd|secret|token|api_key|apikey)[[:space:]]*[:=][[:space:]]*[^[:space:]]{12,}"
    ]
}

public function joined() -> string {
    return patterns().join("|")
}
