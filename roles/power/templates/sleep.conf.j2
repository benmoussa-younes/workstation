#
# systemd reads this drop-in after `/etc/systemd/sleep.conf` and before a
# higher-numbered drop-in. logind parses the effective file on every sleep
# request, so the read-back in the role is immediate and no daemon reload is
# needed.
#
# `AllowHibernation` gates hibernation itself; `AllowHybridSleep` gates hybrid
# sleep, and `AllowSuspendThenHibernate` gates the suspend-then-hibernate verb.
# All three write the same memory image to the swap, so the policy follows one
# switch.
[Sleep]
{% if power_hibernation == 'enabled' %}
AllowHibernation=yes
AllowHybridSleep=yes
AllowSuspendThenHibernate=yes
{% else %}
AllowHibernation=no
AllowHybridSleep=no
AllowSuspendThenHibernate=no
{% endif %}
