#
# The audit found no password policy at all: no pwquality, PASS_MAX_DAYS 99999,
# PASS_MIN_DAYS 0. This applies whenever a password is set — on a site whose
# accounts are key-only, that means "when a human deliberately creates one".
minlen = {{ security_password_min_length }}
dcredit = -1
ucredit = -1
lcredit = -1
ocredit = -1
minclass = 4
maxrepeat = 3
maxsequence = 3
difok = 2
dictcheck = 1
enforcing = 1
enforce_for_root
{% if security_password_reject_userinfo | bool %}
usercheck = 1
{% endif %}
