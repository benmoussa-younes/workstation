#!/usr/sbin/nft -f
# {{ ansible_managed }}
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Loaded by the nftables.service drop-in AFTER the distribution's
# /etc/nftables.conf, which this product never writes. Replace only our own
# table, atomically: a `flush ruleset` here would wipe Docker's chains whenever
# this file is loaded — the very conflict this design exists to avoid.
#
# The sources are split by family. `ip saddr` refuses an IPv6 address and the
# whole ruleset fails its `nft -c`; a site that declares an IPv6 network gets
# its own `ip6 saddr` rule, and a port with both families gets both rules.
{% macro port_rule(rule, sources) -%}
{%     set sources = sources | default([]) %}
{%     set v4 = sources | reject('search', ':') | list %}
{%     set v6 = sources | select('search', ':') | list %}
{%     if sources | length == 0 %}
        {{ rule }} accept
{%     else %}
{%         if v4 | length > 0 %}
        {{ rule }} ip saddr { {{ v4 | join(', ') }} } accept
{%         endif %}
{%         if v6 | length > 0 %}
        {{ rule }} ip6 saddr { {{ v6 | join(', ') }} } accept
{%         endif %}
{%     endif %}
{%- endmacro %}
{% macro protocol_rule(protocol, sources) -%}
{%     set sources = sources | default([]) %}
{%     set v4 = sources | reject('search', ':') | list %}
{%     set v6 = sources | select('search', ':') | list %}
{%     if sources | length == 0 %}
        ip protocol {{ protocol }} accept
        ip6 nexthdr {{ protocol }} accept
{%     else %}
{%         if v4 | length > 0 %}
        ip protocol {{ protocol }} ip saddr { {{ v4 | join(', ') }} } accept
{%         endif %}
{%         if v6 | length > 0 %}
        ip6 nexthdr {{ protocol }} ip6 saddr { {{ v6 | join(', ') }} } accept
{%         endif %}
{%     endif %}
{%- endmacro %}
{% macro forward_rule(flow) -%}
{%     set sources = flow.sources | default([]) %}
{%     set v4 = sources | reject('search', ':') | list %}
{%     set v6 = sources | select('search', ':') | list %}
{%     if sources | length == 0 %}
        iif {{ flow.iif }} oif {{ flow.oif }} accept
{%     else %}
{%         if v4 | length > 0 %}
        iif {{ flow.iif }} oif {{ flow.oif }} ip saddr { {{ v4 | join(', ') }} } accept
{%         endif %}
{%         if v6 | length > 0 %}
        iif {{ flow.iif }} oif {{ flow.oif }} ip6 saddr { {{ v6 | join(', ') }} } accept
{%         endif %}
{%     endif %}
{%- endmacro %}

table inet {{ security_firewall_table }} {}
delete table inet {{ security_firewall_table }}

table inet {{ security_firewall_table }} {
    # `policy drop` is what closes this chain: a packet that matches no rule is
    # dropped, measured on a machine running nftables 1.1.3 where a base chain
    # at `priority -10` holding only that policy refused every undeclared port.
    #
    # The last rule says the same thing in the chain body. It is not what makes
    # the chain closed -- the policy does -- and writing it that way would be a
    # second, weaker declaration of one decision. It is there so the drop is
    # COUNTED: `nft list ruleset` then shows how many packets the ruleset
    # turned away, which the policy alone never reports.
    chain input {
        type filter hook input priority -10; policy drop;

        # Anything we started, and the loopback interface.
        ct state established,related accept
        iif lo accept

        # ICMP and ICMPv6: a host that cannot answer is worse than one that can,
        # and IPv6 neighbour discovery does not work without ICMPv6.
        ip protocol icmp accept
        ip6 nexthdr icmpv6 accept

        # DHCP and DHCPv6 clients.
        udp dport 68 accept
        udp dport 546 accept

        # mDNS: the printer discovery (Avahi through CUPS's `dnssd` backend).
        # The sources follow the site's SSH sources; a site that refuses sets
        # `security_mdns_enabled: false` and loses the discovery.
{% if security_mdns_enabled %}
{{ port_rule('udp dport 5353', security_mdns_sources) }}
{% endif %}

        # SSH, from the declared sources when any are named.
{{ port_rule('tcp dport ' ~ security_ssh_port, security_ssh_sources) }}
{% for service in security_extra_services %}
{{ port_rule(service.proto | default('tcp') ~ ' dport ' ~ service.port, service.sources | default([])) }}
{% endfor %}
{% for proto_rule in security_extra_protocols %}
{{ protocol_rule(proto_rule.protocol, proto_rule.sources | default([])) }}
{% endfor %}
        # The counter the policy cannot give (see the comment above the chain).
        counter drop
    }

    # The FORWARD hook, which the host OWNS. Its policy is declared: `drop`
    # unless the site says otherwise. A site that publishes a service through
    # its own NAT rules must choose `accept`; a DROP policy here silently kills
    # every forwarded port.
    #
    # As with `input`, the policy closes the chain; the terminal rule below is
    # there so the drop is counted.
    chain forward {
        type filter hook forward priority -10; policy {{ security_forward_policy }};

        ct state established,related accept

        # PMTU discovery arrives as a FORWARDED packet: dropping it silently is
        # how large TCP flows hang instead of failing at once.
        ip protocol icmp accept
        ip6 nexthdr icmpv6 accept
{% for flow in security_forward_flows %}
{{ forward_rule(flow) }}
{% endfor %}
{% if security_forward_policy == 'drop' %}
        counter drop
{% endif %}
    }
}
