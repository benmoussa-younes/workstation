#
# The distribution's nftables.service runs one `nft -f /etc/nftables.conf`.
# This drop-in clears that list and runs the site's file first, then the
# product's table. `/etc/nftables.conf` is a package conffile and is never
# written by this product; the site keeps whatever it declares there.
#
# Both files are `nft -f` scripts. The product's file deletes and recreates only
# its own table, so a site table is preserved.
#
# `systemctl reload nftables` follows the distribution's `ExecReload`, which
# loads only `/etc/nftables.conf`. That file starts with `flush ruleset`, so a
# reload wiped the product table and left the workstation unfiltered. The reload
# list is cleared: a reload is refused instead of changing the firewall.
[Service]
ExecStart=
ExecStart=/usr/sbin/nft -f /etc/nftables.conf
ExecStart=/usr/sbin/nft -f {{ security_nftables_file }}
ExecReload=
