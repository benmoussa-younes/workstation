#
# An unattended session. A workstation in a locked room may log in on its own; a
# workstation in a shared office must not, and `display_manager_autologin` is
# false there.
[daemon]
AutomaticLoginEnable=True
AutomaticLogin={{ display_manager_autologin_user }}
